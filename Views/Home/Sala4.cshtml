@{
    ViewData["Title"] = "Sala 4";
}

<div class="sala4-layout">
    <div class="sala4-card">
        <p class="sala4-kicker">Sala 4</p>
        <h1>El próximo desafío comienza</h1>
        <p>Acá seguiría el siguiente paso de la sala de escape.</p>
    </div>
</div>

<style>
    .sala4-layout {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 32px 16px;
        background: linear-gradient(135deg, #111827 0%, #1f2937 100%);
        color: #f8fafc;
        font-family: 'Poppins', sans-serif;
    }

    .sala4-card {
        width: min(100%, 600px);
        background: rgba(17, 24, 39, 0.9);
        border-radius: 20px;
        padding: 40px 32px;
        text-align: center;
        border: 1px solid rgba(148, 163, 184, 0.2);
    }

    .sala4-kicker {
        margin: 0 0 12px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #fbbf24;
        font-weight: 700;
    }

    .sala4-card h1 {
        margin: 0 0 10px;
        font-size: clamp(2rem, 4vw, 2.8rem);
    }

    .sala4-card p {
        margin: 0;
        color: #cbd5e1;
        font-size: 1.05rem;
    }
</style>
