@{
    ViewData["Title"] = "Sala 2";
}

<div class="sala2-layout sala-theme">
    <div class="sala2-card">
        <p class="sala2-kicker">Sala 2: El huevo faltante</p>
        <h1>Pista secreta</h1>
        <p class="sala2-instruction">
            Observá la imagen y hacé click en el huevo verdadero, te podés ayudar con las pistas. 
        </p>

        <div class="sala2-content">
            <div class="envelope-container" aria-hidden="false">
                <button class="envelope" id="openEnvelope" aria-expanded="false" aria-controls="envelopePanel" title="Abrir sobre de pistas">
                    <span class="env-flap"></span>
                </button>

                <div class="envelope-panel" id="envelopePanel" role="dialog" aria-labelledby="envelopeTitle" aria-hidden="true">
                    <h3 id="envelopeTitle">pistas para encontrar el huevo</h3>
                    <ul>
                        <li>Pista 1: “Su posición es un número par.”</li>
                        <li>Pista 2: “Si numerás los huevos de izquierda a derecha y de arriba abajo, su número es múltiplo de 8.”</li>
                        <li>Pista 3: “La columna donde se encuentra tiene un número par.”</li>
                        <li>Pista 4: “Sumá el número de su fila y el de su columna: da 9.”</li>
                    </ul>
                    <button class="close-envelope" id="closeEnvelope">Cerrar</button>
                </div>
            </div>

            <div class="image-puzzle no-overlay" id="imagePuzzle" aria-label="Imagen de la pista oculta" tabindex="0">
                <img src='/huevos.png' alt="Imagen de la sala 2" />
                <div class="grid-overlay" aria-hidden="true"></div>
                <div id="eggReveal" class="egg-reveal hidden" aria-live="polite">40</div>
                <a id="secretRoomButton" class="secret-room-button" asp-controller="Home" asp-action="ResultadoSala2" aria-label="Ir a la sala 3">sala</a>
            </div>

            
            <aside class="rules-box" aria-labelledby="rulesTitle">
                <h3 id="rulesTitle">reglas del juego</h3>
                <ul>
                    <li>Regla: Tenés 3 intentos para encontrar el huevo verdadero siguiendo las pistas dadas y pasar al siguiente desafío</li>
                    
                </ul>
            </aside>
        </div>

        <p id="message" class="message">Sigue buscando…</p>
        <div id="lives" class="lives">Vidas: <span id="livesCount">5</span></div>
        <a id="nextButton" class="next-button hidden" asp-controller="Home" asp-action="CompletarSala2">Siguiente desafío</a>
        
        <!-- Mini-juego de color (hidden por defecto) -->
        <div id="colorMiniGame" class="hidden" aria-hidden="true">
            <div class="color-mini-overlay" id="colorMiniOverlay" style="display:none">
                <div class="color-mini-box" role="dialog" aria-modal="true" aria-labelledby="colorMiniTitle">
                    <h3 id="colorMiniTitle">Juego de recuperación - Replica el color</h3>
                    <p>Se generó un color objetivo. Haz click en la paleta para seleccionar el color que creas que coincide. Si la similitud es >= 70% obtendrás 3 vidas.</p>
                    <div class="color-target" id="colorTarget" title="Color objetivo"></div>
                    <canvas id="colorPalette" class="color-palette" width="560" height="240" role="img" aria-label="Paleta de colores"></canvas>
                    <div style="display:flex;gap:12px;align-items:center;justify-content:center;margin-top:8px;">
                        <div id="colorPreview" class="color-preview" title="Color seleccionado" style="width:48px;height:48px;border-radius:8px;border:2px solid rgba(255,255,255,0.06);background:transparent"></div>
                        <div id="colorFeedback" style="min-height:20px;color:#ffdede;font-weight:700"></div>
                    </div>
                    <div class="color-mini-controls">
                        <button id="colorSelect" class="color-mini-btn" disabled>Seleccionar</button>
                        <button id="colorGiveUp" class="color-mini-btn">Cancelar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .sala2-layout {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 32px 16px;
        background: linear-gradient(135deg, #0f172a 0%, #111827 100%);
        color: #e5e7eb;
        font-family: 'Poppins', sans-serif;
    }

    .sala2-card {
        width: min(100%, 820px);
        background: rgba(15, 23, 42, 0.92);
        border: 1px solid rgba(148, 163, 184, 0.25);
        border-radius: 24px;
        padding: 28px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
        text-align: center;
    }

    .sala2-kicker {
        margin: 0 0 12px;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: #fbbf24;
        font-size: 0.72rem;
        font-weight: 700;
    }

    .sala2-card h1 {
        margin: 0 0 12px;
        font-size: clamp(2rem, 4vw, 3rem);
        color: #f8fafc;
    }

    .sala2-instruction {
        margin: 0 auto 24px;
        max-width: 620px;
        color: #cbd5e1;
        font-size: 1.05rem;
        line-height: 1.6;
    }

    .image-puzzle {
        position: relative;
        width: min(100%, 700px);
        margin: 0 auto;
        border-radius: 18px;
        overflow: hidden;
        border: 2px solid rgba(148, 163, 184, 0.3);
        box-shadow: 0 18px 42px rgba(15, 23, 42, 0.5);
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .image-puzzle:hover,
    .image-puzzle:focus-visible {
        transform: translateY(-2px);
        box-shadow: 0 22px 48px rgba(15, 23, 42, 0.6);
        outline: none;
    }

    .image-puzzle img {
        display: block;
        width: 100%;
        height: auto;
    }

    .grid-overlay {
        position: absolute;
        inset: 0;
        display: grid;
        grid-template-columns: repeat(8, 1fr);
        grid-template-rows: repeat(5, 1fr);
        pointer-events: none;
    }

    .grid-overlay::before {
        content: "";
        grid-column: 2;
        grid-row: 4;
        border: 3px solid #facc15;
        border-radius: 12px;
        margin: 6px;
        background: rgba(250, 204, 21, 0.12);
        box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.25);
    }

    /* Ocultar el recuadro amarillo para la imagen de huevos */
    .image-puzzle.no-overlay .grid-overlay::before {
        display: none;
    }

    .message {
        min-height: 28px;
        margin: 20px 0 18px;
        color: #fbbf24;
        font-weight: 600;
        font-size: 1rem;
    }

    .message.success {
        color: #6ee7b7;
    }

    .next-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 12px 22px;
        border-radius: 999px;
        background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
        color: #111827;
        font-weight: 700;
        text-decoration: none;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        box-shadow: 0 10px 24px rgba(245, 158, 11, 0.45);
    }

    .next-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 14px 28px rgba(245, 158, 11, 0.55);
    }

    .hidden {
        display: none;
    }

    /* Nuevos estilos: sobre de pistas y recuadro de reglas */
    .sala2-content {
        display: flex;
        gap: 18px;
        align-items: flex-start;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 18px;
    }

    .sala2-content > * {
        min-width: 0;
    }

    .envelope-container {
        width: 140px;
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
    }

    .envelope {
        width: 120px;
        height: 80px;
        background: #fff;
        border-radius: 8px;
        border: 2px solid rgba(0,0,0,0.08);
        position: relative;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 20px rgba(0,0,0,0.12);
    }

    .envelope .env-flap {
        position: absolute;
        top: 8px;
        left: 12px;
        right: 12px;
        height: 0;
        border-left: 48px solid transparent;
        border-right: 48px solid transparent;
        border-bottom: 26px solid #f7f7f7;
        border-radius: 4px;
        box-shadow: 0 6px 12px rgba(0,0,0,0.06) inset;
    }

    .envelope-panel {
        position: absolute;
        top: 100px;
        left: 50%;
        transform: translateX(-50%);
        width: 260px;
        background: #ffffff;
        color: #111827;
        border-radius: 12px;
        padding: 14px;
        box-shadow: 0 18px 50px rgba(0,0,0,0.35);
        border: 1px solid rgba(0,0,0,0.06);
        display: none;
        z-index: 50;
    }

    .envelope-panel h3 {
        margin: 0 0 8px 0;
        text-transform: lowercase;
        font-size: 1rem;
        font-weight: 800;
    }

    .envelope-panel ul { margin: 0 0 10px 18px; }

    .envelope-panel .close-envelope {
        display: inline-block;
        padding: 6px 10px;
        background: linear-gradient(135deg,#f093fb,#eea8b1);
        color: #fff;
        border-radius: 10px;
        border: none;
        cursor: pointer;
        font-weight: 700;
    }

    .envelope-panel.open { display: block; }

    .rules-box {
        width: 100%;
        flex: 1 1 220px;
        background: rgba(255,255,255,0.06);
        border-radius: 12px;
        padding: 12px;
        color: #fff8eb;
        border: 1px solid rgba(255,224,168,0.12);
        box-shadow: 0 10px 30px rgba(0,0,0,0.25);
        overflow-wrap: anywhere;
        word-break: break-word;
    }

    .rules-box h3 { margin: 0 0 8px 0; text-transform: lowercase; }

    .rules-box ul {
        margin: 0;
        padding-left: 18px;
    }

    .rules-box li {
        line-height: 1.5;
        margin-bottom: 8px;
    }

    .lives {
        margin-top: 12px;
        font-weight: 800;
        color: #ffd166;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    .penalty-timer {
        display: inline-block;
        margin-left: 8px;
        color: #ffb4b4;
        font-weight: 700;
    }

    .egg-reveal {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: clamp(3rem, 8vw, 7rem);
        font-weight: 900;
        color: #facc15;
        text-shadow: 0 0 20px rgba(250, 204, 21, 0.7);
        background: rgba(15, 23, 42, 0.32);
        pointer-events: none;
    }

    .egg-reveal.hidden {
        display: none;
    }

    .secret-room-button {
        margin-bottom: 13.5%;
        padding-top: 3%;
        margin-right: 10%;
        position: absolute;
        left: 37%;
        bottom: 18px;
        z-index: 10;
        border: none;
        border-radius: 999px;
        background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
        color: #fff;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        box-shadow: 0 8px 20px rgba(34, 197, 94, 0.35);
        cursor: pointer;
        opacity: 0%;
    }

    .secret-room-button:hover {
        filter: brightness(1.08);
    }

    .incorrect-flash {
        animation: incorrectFlash 360ms ease;
    }

    @@keyframes incorrectFlash {
        0% { box-shadow: 0 0 0 0 rgba(239,68,68,0); transform: none; }
        30% { box-shadow: 0 0 0 8px rgba(239,68,68,0.85) inset; transform: translateY(-2px); }
        100% { box-shadow: 0 0 0 0 rgba(239,68,68,0); transform: none; }
    }

    /* Mini-juego de color */
    .color-mini-overlay {
        position: fixed;
        inset: 0;
        background: rgba(2,6,23,0.7);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 2000;
    }

    .color-mini-box {
        background: #0b1220;
        color: #fff;
        border-radius: 12px;
        padding: 18px;
        width: min(92%, 720px);
        box-shadow: 0 12px 40px rgba(2,6,23,0.8);
        text-align: center;
    }

    .color-target {
        width: 120px;
        height: 120px;
        border-radius: 8px;
        margin: 8px auto 12px auto;
        border: 3px solid rgba(255,255,255,0.06);
    }

    .color-palette {
        display: block;
        margin: 8px auto 12px auto;
        width: 100%;
        max-width: 560px;
        height: 240px;
        border-radius: 8px;
        cursor: crosshair;
        border: 1px solid rgba(255,255,255,0.06);
    }

    .color-mini-controls {
        display:flex;
        gap:12px;
        justify-content:center;
        margin-top:12px;
    }

    .color-mini-btn {
        padding:8px 14px;
        border-radius:8px;
        background:linear-gradient(135deg,#60a5fa,#3b82f6);
        color:#07203a;
        font-weight:700;
        border:none;
        cursor:pointer;
    }

    .color-preview { box-shadow: 0 6px 18px rgba(2,6,23,0.6); }
    .color-mini-btn[disabled] { opacity: 0.5; cursor: not-allowed; }

</style>

<script>
    (function () {
        const puzzle = document.getElementById("imagePuzzle");
        const message = document.getElementById("message");
        const nextButton = document.getElementById("nextButton");
        const livesCountEl = document.getElementById('livesCount');
        const livesEl = document.getElementById('lives');
        const eggReveal = document.getElementById('eggReveal');

        // Ajuste de cuadrícula para 40 huevos (8 columnas x 5 filas)
        const cols = 8;
        const rows = 5;
        // Huevo correcto: número 40 (índice 39, 0-based)
        const targetIndex = 39;

        function getCellFromClick(event) {
            const rect = puzzle.getBoundingClientRect();
            const x = event.clientX - rect.left;
            const y = event.clientY - rect.top;

            const cellWidth = rect.width / cols;
            const cellHeight = rect.height / rows;

            const col = Math.min(cols - 1, Math.max(0, Math.floor(x / cellWidth)));
            const row = Math.min(rows - 1, Math.max(0, Math.floor(y / cellHeight)));

            return { col, row };
        }

        // Game mechanics: vidas, huevos incorrectos y huevo especial
        const totalCells = cols * rows;
        if (targetIndex >= totalCells) {
            console.warn('targetIndex fuera de rango, ajustando al último índice');
        }

        function shuffle(array) {
            for (let i = array.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [array[i], array[j]] = [array[j], array[i]];
            }
        }

        // Juego simplificado: 3 vidas, cualquier click dentro de la imagen que no sea la celda correcta resta 1 vida
        let lives = 3;
        let gameOver = false;

        function updateLives() {
            if (livesCountEl) livesCountEl.textContent = String(lives);
        }

        // Exponer función para que el mini-juego pueda reasignar vidas
        window.sala2_setLives = function (n) {
            lives = Number(n) || 0;
            updateLives();
            gameOver = false;
            if (message) message.textContent = `Vidas: ${lives}`;
        };

        updateLives();

        puzzle.addEventListener("click", function (event) {
            if (gameOver) return;

            // si se hizo click sobre el enlace del botón secreto, no penalizar (dejar que navegue)
            if (event.target && event.target.closest && event.target.closest('#secretRoomButton')) {
                return;
            }

            const cell = getCellFromClick(event);
            const idx = cell.row * cols + cell.col;

            if (idx === targetIndex) {
                message.textContent = "¡Correcto! Encontraste el huevo número 40.";
                message.classList.add("success");
                if (eggReveal) {
                    eggReveal.classList.remove("hidden");
                }
                nextButton.classList.remove("hidden");
                puzzle.setAttribute("aria-label", "La pista ha sido encontrada");
                gameOver = true;
                return;
            }

            // cualquier otro click resta una vida
            lives -= 1;
            updateLives();
                if (lives <= 0) {
                    // lanzar mini-juego de color para recuperar vidas
                    gameOver = true;
                    nextButton.classList.add("hidden");
                    startColorMiniGame && startColorMiniGame();
                    return;
                }

            message.textContent = `Incorrecto. Te quedan ${lives} vidas.`;
            message.classList.remove("success");
            // feedback visual breve: borde/flash rojo
            if (puzzle) {
                puzzle.classList.add('incorrect-flash');
                setTimeout(() => puzzle.classList.remove('incorrect-flash'), 360);
            }
        });

        puzzle.addEventListener("keydown", function (event) {
            if (event.key === "Enter" || event.key === " ") {
                event.preventDefault();
                puzzle.click();
            }
        });
    })();
    // Envío: lógica del sobre de pistas
    (function () {
        const openBtn = document.getElementById('openEnvelope');
        const panel = document.getElementById('envelopePanel');
        const closeBtn = document.getElementById('closeEnvelope');

        if (!openBtn || !panel) return;

        function openPanel() {
            panel.classList.add('open');
            panel.setAttribute('aria-hidden', 'false');
            openBtn.setAttribute('aria-expanded', 'true');
        }

        function closePanel() {
            panel.classList.remove('open');
            panel.setAttribute('aria-hidden', 'true');
            openBtn.setAttribute('aria-expanded', 'false');
        }

        openBtn.addEventListener('click', function (e) {
            e.stopPropagation();
            if (panel.classList.contains('open')) closePanel(); else openPanel();
        });

        closeBtn && closeBtn.addEventListener('click', function (e) {
            e.stopPropagation();
            closePanel();
        });

        // cerrar al hacer click fuera
        document.addEventListener('click', function (e) {
            if (!panel.contains(e.target) && e.target !== openBtn) {
                closePanel();
            }
        });

        // accesibilidad: Esc cierra
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closePanel();
        });
    })();

</script>

<script>
    // Mini-juego: paleta de color y comparación por similitud (>=70%)
    (function () {
        const overlay = document.getElementById('colorMiniOverlay');
        const wrapper = document.getElementById('colorMiniGame');
        const targetEl = document.getElementById('colorTarget');
        const canvas = document.getElementById('colorPalette');
        const feedback = document.getElementById('colorFeedback');
        const giveUp = document.getElementById('colorGiveUp');
        let ctx = null;
        let targetColor = { r: 0, g: 0, b: 0 };

        function randColor() {
            return {
                r: Math.floor(Math.random() * 256),
                g: Math.floor(Math.random() * 256),
                b: Math.floor(Math.random() * 256)
            };
        }

        function rgbToCss(c) { return `rgb(${c.r}, ${c.g}, ${c.b})`; }

        function drawPalette() {
            if (!canvas) return;
            ctx = canvas.getContext('2d');
            const w = canvas.width;
            const h = canvas.height;

            // horizontal hue gradient
            const hueGrad = ctx.createLinearGradient(0, 0, w, 0);
            hueGrad.addColorStop(0, 'red');
            hueGrad.addColorStop(0.16, 'yellow');
            hueGrad.addColorStop(0.33, 'lime');
            hueGrad.addColorStop(0.5, 'cyan');
            hueGrad.addColorStop(0.66, 'blue');
            hueGrad.addColorStop(0.83, 'magenta');
            hueGrad.addColorStop(1, 'red');
            ctx.fillStyle = hueGrad;
            ctx.fillRect(0, 0, w, h);

            // vertical white overlay (saturation)
            const whiteGrad = ctx.createLinearGradient(0, 0, 0, h);
            whiteGrad.addColorStop(0, 'rgba(255,255,255,1)');
            whiteGrad.addColorStop(1, 'rgba(255,255,255,0)');
            ctx.fillStyle = whiteGrad;
            ctx.fillRect(0, 0, w, h);

            // vertical black overlay (value)
            const blackGrad = ctx.createLinearGradient(0, 0, 0, h);
            blackGrad.addColorStop(0, 'rgba(0,0,0,0)');
            blackGrad.addColorStop(1, 'rgba(0,0,0,1)');
            ctx.fillStyle = blackGrad;
            ctx.fillRect(0, 0, w, h);
        }

        function pickColorAt(ev) {
            if (!ctx) return null;
            const rect = canvas.getBoundingClientRect();
            const x = Math.floor((ev.clientX - rect.left) * (canvas.width / rect.width));
            const y = Math.floor((ev.clientY - rect.top) * (canvas.height / rect.height));
            const data = ctx.getImageData(x, y, 1, 1).data;
            return { r: data[0], g: data[1], b: data[2] };
        }

        function colorDistance(a, b) {
            const dr = a.r - b.r;
            const dg = a.g - b.g;
            const db = a.b - b.b;
            return Math.sqrt(dr*dr + dg*dg + db*db);
        }

        function similarityPercent(a, b) {
            const maxDist = Math.sqrt(3 * 255 * 255);
            const dist = colorDistance(a, b);
            return Math.max(0, 1 - dist / maxDist);
        }

        function showOverlay(show) {
            if (!overlay || !wrapper) return;
            overlay.style.display = show ? 'flex' : 'none';
            wrapper.classList.toggle('hidden', !show);
            wrapper.setAttribute('aria-hidden', show ? 'false' : 'true');
        }

        function startColorMiniGame() {
            if (!overlay) return;
            // preparar palette y target
            targetColor = randColor();
            if (targetEl) targetEl.style.background = rgbToCss(targetColor);
            drawPalette();
            feedback.textContent = '';
            showOverlay(true);
            // bloquear interacciones con la imagen
        }

        function endColorMiniGame(success) {
            showOverlay(false);
            if (success) {
                // dar 3 vidas via la API expuesta
                if (window.sala2_setLives) {
                    window.sala2_setLives(3);
                }
                if (message) message.textContent = 'Has conseguido 3 vidas. ¡A jugar!';
                gameOver = false;
            } else {
                // si el usuario cancela, dejar en gameOver (puede reiniciar desde el juego)
                if (message) message.textContent = 'Mini-juego cancelado. Vidas: 0.';
            }
        }

        // interacción: click en paleta -> mostrar preview y activar 'Seleccionar'
        let pickedColor = null;
        const previewEl = document.getElementById('colorPreview');
        const selectBtn = document.getElementById('colorSelect');

        canvas && canvas.addEventListener && canvas.addEventListener('click', function (ev) {
            const picked = pickColorAt(ev);
            if (!picked) return;
            pickedColor = picked;
            previewEl && (previewEl.style.background = rgbToCss(pickedColor));
            feedback.textContent = `Color seleccionado: ${pickedColor.r}, ${pickedColor.g}, ${pickedColor.b}. Presiona Seleccionar.`;
            selectBtn && (selectBtn.disabled = false);
        });

        // confirmar selección
        selectBtn && selectBtn.addEventListener && selectBtn.addEventListener('click', function () {
            if (!pickedColor) return;
            const sim = similarityPercent(pickedColor, targetColor);
            const pct = Math.round(sim * 100);
            if (sim >= 0.7) {
                feedback.style.color = '#b7f5d6';
                feedback.textContent = `¡Correcto! Similitud ${pct}%. Recuperaste 3 vidas.`;
                endColorMiniGame(true);
            } else {
                feedback.style.color = '#ffdede';
                feedback.textContent = `Similitud ${pct}%. Menos del 70% — nuevo color.`;
                // nuevo objetivo
                targetColor = randColor();
                targetEl && (targetEl.style.background = rgbToCss(targetColor));
                // reset selección
                pickedColor = null;
                previewEl && (previewEl.style.background = 'transparent');
                selectBtn && (selectBtn.disabled = true);
            }
        });

        giveUp && giveUp.addEventListener && giveUp.addEventListener('click', function () {
            endColorMiniGame(false);
        });

        // Exponer la función para que la IIFE principal la invoque
        window.startColorMiniGame = startColorMiniGame;
    })();
</script>
