@{
    ViewData["Title"] = "Sala 2";
}

<div class="sala2-layout">
    <div class="sala2-card">
        <p class="sala2-kicker">Sala 2 · El despensa oculta</p>
        <h1>Pista secreta</h1>
        <p class="sala2-instruction">
            Observá la imagen y hacé click 
        </p>

        <div class="image-puzzle" id="imagePuzzle" aria-label="Imagen de la pista oculta" tabindex="0">
            <img src='wwwroot/huevos.jpg' alt="Imagen de la sala 2" />
            <div class="grid-overlay" aria-hidden="true"></div>
        </div>

        <p id="message" class="message">Sigue buscando…</p>
        <a id="nextButton" class="next-button hidden" asp-controller="Home" asp-action="Sala3">Siguiente desafío</a>
    </div>
</div>

<style>
    .sala2-layout {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 32px 16px;
        background: linear-gradient(135deg, #0f172a 0%, #111827 100%);
        color: #e5e7eb;
        font-family: 'Poppins', sans-serif;
    }

    .sala2-card {
        width: min(100%, 820px);
        background: rgba(15, 23, 42, 0.92);
        border: 1px solid rgba(148, 163, 184, 0.25);
        border-radius: 24px;
        padding: 28px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
        text-align: center;
    }

    .sala2-kicker {
        margin: 0 0 12px;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: #fbbf24;
        font-size: 0.72rem;
        font-weight: 700;
    }

    .sala2-card h1 {
        margin: 0 0 12px;
        font-size: clamp(2rem, 4vw, 3rem);
        color: #f8fafc;
    }

    .sala2-instruction {
        margin: 0 auto 24px;
        max-width: 620px;
        color: #cbd5e1;
        font-size: 1.05rem;
        line-height: 1.6;
    }

    .image-puzzle {
        position: relative;
        width: min(100%, 700px);
        margin: 0 auto;
        border-radius: 18px;
        overflow: hidden;
        border: 2px solid rgba(148, 163, 184, 0.3);
        box-shadow: 0 18px 42px rgba(15, 23, 42, 0.5);
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .image-puzzle:hover,
    .image-puzzle:focus-visible {
        transform: translateY(-2px);
        box-shadow: 0 22px 48px rgba(15, 23, 42, 0.6);
        outline: none;
    }

    .image-puzzle img {
        display: block;
        width: 100%;
        height: auto;
    }

    .grid-overlay {
        position: absolute;
        inset: 0;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        grid-template-rows: repeat(5, 1fr);
        pointer-events: none;
    }

    .grid-overlay::before {
        content: "";
        grid-column: 2;
        grid-row: 4;
        border: 3px solid #facc15;
        border-radius: 12px;
        margin: 6px;
        background: rgba(250, 204, 21, 0.12);
        box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.25);
    }

    .message {
        min-height: 28px;
        margin: 20px 0 18px;
        color: #fbbf24;
        font-weight: 600;
        font-size: 1rem;
    }

    .message.success {
        color: #6ee7b7;
    }

    .next-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 12px 22px;
        border-radius: 999px;
        background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
        color: #111827;
        font-weight: 700;
        text-decoration: none;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        box-shadow: 0 10px 24px rgba(245, 158, 11, 0.45);
    }

    .next-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 14px 28px rgba(245, 158, 11, 0.55);
    }

    .hidden {
        display: none;
    }
</style>

<script>
    (function () {
        const puzzle = document.getElementById("imagePuzzle");
        const message = document.getElementById("message");
        const nextButton = document.getElementById("nextButton");

        const cols = 3;
        const rows = 5;
        const targetCol = 1;
        const targetRow = 3;

        function getCellFromClick(event) {
            const rect = puzzle.getBoundingClientRect();
            const x = event.clientX - rect.left;
            const y = event.clientY - rect.top;

            const cellWidth = rect.width / cols;
            const cellHeight = rect.height / rows;

            const col = Math.min(cols - 1, Math.max(0, Math.floor(x / cellWidth)));
            const row = Math.min(rows - 1, Math.max(0, Math.floor(y / cellHeight)));

            return { col, row };
        }

        puzzle.addEventListener("click", function (event) {
            const cell = getCellFromClick(event);

            if (cell.col === targetCol && cell.row === targetRow) {
                message.textContent = "¡Correcto! La pista ha sido desbloqueada.";
                message.classList.add("success");
                nextButton.classList.remove("hidden");
                puzzle.setAttribute("aria-label", "La pista ha sido encontrada");
                return;
            }

            message.textContent = "No es ahí. La pista está en la columna del medio y la anteúltima fila.";
            message.classList.remove("success");
            nextButton.classList.add("hidden");
        });

        puzzle.addEventListener("keydown", function (event) {
            if (event.key === "Enter" || event.key === " ") {
                event.preventDefault();
                puzzle.click();
            }
        });
    })();
</script>
