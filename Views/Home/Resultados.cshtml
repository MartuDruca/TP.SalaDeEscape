@model ResultadoViewModel

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Resultados</title>
    <style>
        :root {
            --bg: #1b1024;
            --panel: rgba(34, 20, 44, 0.9);
            --panel-border: rgba(255, 210, 120, 0.25);
            --accent: #ffb703;
            --accent-2: #ff7b54;
            --text: #fff6d9;
            --muted: #f0d9b5;
            --row: rgba(255,255,255,0.04);
            --success: #7ef29a;
        }

        * { box-sizing: border-box; }

        html, body {
            margin: 0;
            min-height: 100%;
            font-family: Arial, sans-serif;
            background: radial-gradient(circle at top, #2b1636 0%, var(--bg) 42%, #120b17 100%);
            color: var(--text);
        }

        body {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 32px 18px;
        }

        .results-shell {
            width: min(100%, 980px);
            background: var(--panel);
            border: 1px solid var(--panel-border);
            border-radius: 22px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.35);
            padding: clamp(22px, 4vw, 42px);
        }

        .results-kicker {
            margin: 0 0 8px;
            color: var(--accent);
            text-transform: uppercase;
            letter-spacing: 0.16em;
            font-size: 12px;
            font-weight: 700;
        }

        h1 {
            margin: 0 0 12px;
            font-size: clamp(2rem, 4vw, 3rem);
            color: #fff;
        }

        .summary {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 14px;
            margin: 20px 0 26px;
        }

        .info-box {
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 14px;
            padding: 14px 16px;
        }

        .label {
            display: block;
            color: var(--muted);
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.09em;
            margin-bottom: 8px;
        }

        .value {
            font-weight: 700;
            font-size: 1.05rem;
            color: var(--text);
        }

        .ranking-title {
            margin: 0 0 12px;
            color: var(--accent);
            font-size: 1.4rem;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            overflow: hidden;
            border-radius: 12px;
            background: rgba(255,255,255,0.02);
            border: 1px solid rgba(255,255,255,0.08);
        }

        th, td {
            padding: 12px 14px;
            border-bottom: 1px solid rgba(255,255,255,0.08);
            text-align: left;
        }

        th {
            background: rgba(255,183,3,0.12);
            color: var(--accent);
            font-size: 0.8rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        tbody tr:nth-child(odd) {
            background: var(--row);
        }

        tbody tr:last-child td {
            border-bottom: none;
        }

        .actions {
            margin-top: 24px;
            display: flex;
            justify-content: flex-end;
        }

        .primary-button {
            background: linear-gradient(135deg, var(--accent-2), var(--accent));
            border: none;
            border-radius: 12px;
            color: #fff;
            font-weight: 700;
            padding: 12px 20px;
            cursor: pointer;
            box-shadow: 0 14px 28px rgba(255,123,84,0.22);
        }

        @@media (max-width: 640px) {
            body { padding: 18px 12px; }
            .summary { grid-template-columns: 1fr; }
            th, td { padding: 10px 8px; }
        }
    </style>
</head>
<body>
    <div class="results-shell">
        <p class="results-kicker">RESULTADOS</p>
        <h1>Feliciades! Escapaste de la cocina embrujada 🧙🍳🔪</h1>

        <div class="summary">
            <div class="info-box">
                <span class="label">Jugador</span>
                <span class="value">@Model.Nombre</span>
            </div>
            <div class="info-box">
                <span class="label">Tiempo total</span>
                <span class="value">@Model.TiempoTotal.ToString()</span>
            </div>
            <div class="info-box">
                <span class="label">Salas completadas</span>
                <span class="value">@(Model.SalasCompletadas.Count == 0 ? "Ninguna" : string.Join(", ", Model.SalasCompletadas))</span>
            </div>
        </div>
        
        <div class="actions">
                <div class="actions">
                    <form method="post" action="@Url.Action("Cierre","Home")" onsubmit="(function(){ try { if(typeof clearGlobalTimer === 'function') clearGlobalTimer(); localStorage.removeItem('escapeGameTimer'); localStorage.removeItem('escapeGameTimerStartedAt'); } catch(e){} })();">
                        <button type="submit" class="primary-button">Cerrar sesión</button>
                    </form>
                </div>
</body>
</html>