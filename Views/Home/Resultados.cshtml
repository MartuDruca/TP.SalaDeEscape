@model ResultadoViewModel

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Resultados</title>
    <style>
        body { font-family: Arial, sans-serif; padding: 24px; background:#f5f5f5 }
        .card { max-width:900px; margin:24px auto; background:#fff; padding:20px; border-radius:8px; box-shadow:0 6px 20px rgba(0,0,0,0.08)}
        h1{margin-bottom:6px}
        .small{color:#666}
        table{width:100%;border-collapse:collapse;margin-top:12px}
        th,td{padding:8px;border-bottom:1px solid #eee;text-align:left}
    </style>
</head>
<body>
    <div class="card">
        <h1>Resultados de la partida</h1>
        <p class="small">Jugador: <strong>@Model.Nombre</strong></p>
        <p class="small">Tiempo total: <strong>@Model.TiempoTotal.ToString()</strong></p>
        <p class="small">Salas completadas: <strong>@(Model.SalasCompletadas.Count == 0 ? "Ninguna" : string.Join(", ", Model.SalasCompletadas))</strong></p>

        <h2>Tabla de posiciones</h2>
        <table>
            <thead>
                <tr><th>Pos</th><th>Jugador</th><th>Salas</th><th>Tiempo</th></tr>
            </thead>
            <tbody>
                @if (Model.Leaderboard.Count == 0)
                {
                    <tr><td colspan="4">No hay datos en la base de datos.</td></tr>
                }
                else
                {
                    var pos = 1;
                    foreach (var it in Model.Leaderboard.Take(10))
                    {
                        <tr>
                            <td>@pos</td>
                            <td>@it.Nombre</td>
                            <td>@it.SalasCompletadas</td>
                            <td>@it.Tiempo.ToString()</td>
                        </tr>
                        pos++;
                    }
                }
            </tbody>
        </table>

        <div style="margin-top:16px">
            <form method="post" action="@Url.Action("Cierre","Home")">
                <button type="submit">Cerrar sesión</button>
            </form>
        </div>
    </div>
</body>
</html>